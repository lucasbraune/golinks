<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Go links</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='13' fill='%2363b37b'/%3E%3C/svg%3E">
</head>
<body>
  <p class="eyebrow"><span class="dot"></span>localhost:<%= PORT %></p>
  <h1>Go links</h1>
  <p class="subtitle">
    <%= grouped.sum { |_url, pairs| pairs.size } %> links &mdash;
    type <code>go &lt;name&gt;</code> in Chrome, or click one below.
  </p>

  <div class="card">
    <table>
      <thead>
        <tr><th>Name</th><th>Destination</th></tr>
      </thead>
      <tbody>
        <% grouped.each do |url, pairs| %>
        <tr>
          <td class="names-cell">
            <div class="names">
              <% pairs.each do |name, _entry| %><a class="chip" href="/<%= h(name) %>"><%= h(name) %></a><% end %>
            </div>
          </td>
          <td class="dest">
            <span class="arrow">&rarr;</span><a class="url" href="<%= h(url) %>"><%= h(truncate(url)) %></a>
            <% search_url = pairs.first.last[:search_url] %>
            <% if search_url && !search_url.strip.empty? %>
            <div class="search-url"><%= h(truncate(search_url)) %></div>
            <% end %>
          </td>
        </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <footer>
    <a href="vscode://file<%= h(links_file) %>">Edit data/links.csv &rarr;</a>
  </footer>
</body>
</html>
