<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= h(heading) %> &mdash; Go links</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='13' fill='%2363b37b'/%3E%3C/svg%3E">
  <%# Needed here too, not just on the links page: without it, navigating to
      the form would paint the system theme before correcting itself. %>
  <script src="/theme.js"></script>
</head>
<body>
  <h1><%= h(heading) %></h1>

  <div class="card form-card">
    <% if error %>
      <p class="form-error"><%= h(error) %></p>
    <% end %>
    <form method="post" action="<%= h(action) %>">
      <label>
        Name <span class="hint">letters, numbers, and . _ - / &mdash; no spaces</span>
        <input type="text" name="new_name" value="<%= h(name) %>" placeholder="wiki" required autofocus>
      </label>

      <label>
        Destination URL
        <input type="text" name="url" value="<%= h(url) %>" placeholder="https://en.wikipedia.org" required>
      </label>

      <label>
        Description <span class="hint">optional &mdash; shown next to the name in the links list</span>
        <div class="description-row">
          <input type="text" name="description" id="description" value="<%= h(description) %>"
                 placeholder="Wikipedia free online encyclopedia" maxlength="120">
          <%# hidden until link_form.js un-hides it: without JS the button can't
              do anything, and an inert control is worse than no control. %>
          <button type="button" id="generate-description" class="generate-button" hidden>Generate</button>
        </div>
      </label>
      <%# Sits outside the label so a screen reader doesn't read status text as
          part of the field's name. aria-live announces the result of a click
          that otherwise only changes a value the user isn't focused on. %>
      <p class="description-status" id="description-status" role="status" aria-live="polite"></p>

      <label>
        Search URL <span class="hint">optional &mdash; use %s for the search terms</span>
        <input type="text" name="search_url" value="<%= h(search_url) %>" placeholder="https://en.wikipedia.org/w/index.php?search=%s">
      </label>

      <fieldset class="aliases-field">
        <legend>Aliases <span class="hint">optional &mdash; other names that go to the same place</span></legend>
        <div class="alias-list" id="alias-list">
          <% (aliases.empty? ? [''] : aliases).each do |a| %>
          <div class="alias-row">
            <input type="text" name="aliases[]" value="<%= h(a) %>" placeholder="yt">
            <button type="button" class="remove-alias" aria-label="Remove alias">&times;</button>
          </div>
          <% end %>
        </div>
        <button type="button" id="add-alias" class="link-button add-alias">+ Add alias</button>
      </fieldset>

      <div class="form-actions">
        <button type="submit">Save</button>
        <a class="cancel" href="/links">Cancel</a>
      </div>
    </form>

    <% if original_name %>
    <form method="post" action="/links/<%= h(original_name) %>/delete" class="delete-form"
          onsubmit="return confirm('Delete this link?')">
      <button type="submit" class="link-button danger">Delete this link</button>
    </form>
    <% end %>
  </div>

  <footer class="page-footer">
    <p class="eyebrow"><span class="dot"></span>localhost:<%= PORT %></p>
    <button type="button" id="theme-toggle" class="theme-toggle"></button>
  </footer>

  <script src="/link_form.js"></script>
</body>
</html>
