<h1><%= h(heading) %></h1>

<div class="card form-card">
  <% if error %>
    <p class="form-error"><%= h(error) %></p>
  <% end %>
  <form method="post" action="<%= h(action) %>">
    <%# Every field is the same three parts in the same order: a head (name,
        plus an "Optional" tag when it is), the control, and one help line.
        The help line is only painted while the field has focus — see
        .field-help — so the resting form is labels and inputs, and the
        explanation arrives at the moment you're actually in the field. %>
    <div class="field">
      <div class="field-head">
        <label for="name">Name</label>
      </div>
      <%# The go/ prefix is the field's real subject: what you type here is
          the tail of go/<name>. Showing it does the job three sentences of
          hint text were doing, and ties the form to the thing it edits. %>
      <div class="input-prefix">
        <span class="prefix" aria-hidden="true">go/</span>
        <input type="text" id="name" name="new_name" value="<%= h(name) %>" placeholder="wiki"
               aria-describedby="name-help" required autofocus>
      </div>
      <p class="field-help" id="name-help">Letters, numbers, and . _ - / &mdash; no spaces</p>
    </div>

    <div class="field">
      <div class="field-head">
        <label for="url">Destination URL</label>
      </div>
      <%# Chrome otherwise offers every URL ever typed into a field named
          "url" here, which is noise: the destination is pasted from the tab
          you're linking to, not recalled. Same for search_url below. %>
      <input type="text" id="url" name="url" value="<%= h(url) %>" placeholder="https://en.wikipedia.org"
             autocomplete="off" spellcheck="false" required>
    </div>

    <div class="field">
      <div class="field-head">
        <label for="description">Description</label>
        <span class="optional">Optional</span>
      </div>
      <div class="description-row">
        <input type="text" name="description" id="description" value="<%= h(description) %>"
               placeholder="Wikipedia free online encyclopedia" maxlength="120"
               aria-describedby="description-help" autocomplete="off">
        <%# hidden until link_form.js un-hides it: without JS the button can't
            do anything, and an inert control is worse than no control. %>
        <button type="button" data-generate-description class="generate-button" hidden>Generate</button>
      </div>
      <p class="field-help" id="description-help">Shown next to the name in the links list</p>
      <%# Shares the help line's slot and outranks it: a result you asked for
          beats a standing hint. Outside the label so a screen reader doesn't
          read status text as part of the field's name; aria-live announces a
          click that otherwise only changes a value you aren't focused on. %>
      <p class="description-status" data-description-status role="status" aria-live="polite"></p>
    </div>

    <div class="field">
      <div class="field-head">
        <label for="search-url">Search URL</label>
        <span class="optional">Optional</span>
      </div>
      <input type="text" id="search-url" name="search_url" value="<%= h(search_url) %>"
             placeholder="https://en.wikipedia.org/w/index.php?search=%s" aria-describedby="search-url-help"
             autocomplete="off" spellcheck="false">
      <p class="field-help" id="search-url-help">Put %s where the search terms go</p>
    </div>

    <%# role="group" + aria-labelledby rather than fieldset/legend: same
        semantics, and it lets the head be the same flex row as every other
        field's instead of fighting legend's layout rules. %>
    <div class="field" role="group" aria-labelledby="aliases-label" aria-describedby="aliases-help">
      <div class="field-head">
        <span id="aliases-label">Aliases</span>
        <span class="optional">Optional</span>
      </div>
      <div class="alias-list" data-alias-list>
        <% (aliases.empty? ? [''] : aliases).each do |a| %>
        <div class="alias-row" data-alias-row>
          <div class="input-prefix">
            <span class="prefix" aria-hidden="true">go/</span>
            <input type="text" name="aliases[]" value="<%= h(a) %>" placeholder="yt" aria-label="Alias" autocomplete="off" spellcheck="false">
          </div>
          <button type="button" class="remove-alias" data-role="remove-alias" aria-label="Remove alias">&times;</button>
        </div>
        <% end %>
      </div>
      <button type="button" data-add-alias class="link-button add-alias">Add another</button>
      <p class="field-help" id="aliases-help">Other names for the same link</p>
    </div>

    <div class="form-actions">
      <%# The button says what it does, and says the same thing the page
          promised: "Add a link" saves with "Add link". %>
      <button type="submit"><%= original_name ? 'Save changes' : 'Add link' %></button>
      <a class="cancel" href="/links">Cancel</a>
    </div>
  </form>

  <% if original_name %>
  <%# The dialog is a sibling of the delete form, not nested inside it: HTML
      forbids nested forms, and the dialog carries its own (method="dialog",
      below). %>
  <form method="post" action="/links/<%= h(original_name) %>/delete" class="delete-form" data-delete-form>
    <button type="submit" class="link-button danger">Delete this link</button>
  </form>

  <dialog class="confirm-dialog" data-delete-dialog>
    <p>Delete <strong>go/<%= h(original_name) %></strong>?</p>
    <%# method="dialog" closes the dialog and sets returnValue from the button
        that submitted it, so neither button needs a click listener. %>
    <form method="dialog" class="confirm-actions">
      <button value="cancel" class="link-button">Cancel</button>
      <button value="delete" class="danger">Delete</button>
    </form>
  </dialog>
  <% end %>
</div>
