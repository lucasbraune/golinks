<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lucasbraune.golinks</string>

    <!--
      Per-user LaunchAgent: starts the server at login, running as the
      logged-in user (no root), with the server's defaults: port 51242 on all
      interfaces. Restarts it if it crashes (KeepAlive).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>__REPO_DIR__/launchd/golinks</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/golinks.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/golinks.error.log</string>
</dict>
</plist>
